---
import Layout from '../layouts/Layout.astro';
import SetupThumb from '../components/SetupThumb.astro';
import GearBadge from '../components/GearBadge.astro';
import BandBadge from '../components/BandBadge.astro';
import { getCollection } from 'astro:content';

// Fetch all setups from the content collection
const setups = await getCollection('setups');

const extractBand = (title: string) => {
    if (!title) return '';
    return title
        .replace(/\(.*?\)/g, '') // Remove parenthesis like (Jangly)
        .replace(/\s+(I|II|III|IV|V|VI|VII|VIII|IX|X)$/i, '') // Remove roman numerals
        .trim();
};

// Extract unique gear and bands for the global filters
const uniqueGear = new Set<string>();
const uniqueBands = new Set<string>();

setups.forEach((setup: any) => {
    // Gear
    if (setup.data.guitar) uniqueGear.add(setup.data.guitar);
    if (setup.data.amp) uniqueGear.add(setup.data.amp);
    if (setup.data.pedals) {
        setup.data.pedals.forEach((pedal: string) => uniqueGear.add(pedal));
    }
    // Band
    if (setup.data.artist) {
        uniqueBands.add(setup.data.artist);
    }
});
const allGearTags = Array.from(uniqueGear).sort();
const allBandTags = Array.from(uniqueBands).sort();
---

<Layout title="Rig Craft Labs">

    <!-- NAVEGAÇÃO PRINCIPAL -->
    <div class="bg-black/60 p-6 sm:p-8 rounded-xl shadow-[inset_0_2px_10px_rgba(0,0,0,0.8)] border border-black/50 mb-12 max-w-4xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-center">
            <!-- Linha 1 -->
            <a href={`${import.meta.env.BASE_URL}/tank-g-presets`} class="w-full inline-block bg-accentOrange text-bgMain py-3 px-4 rounded text-lg font-bold no-underline transition-transform duration-200 hover:-translate-y-1 hover:bg-[#e68a00] hover:shadow-[0_5px_15px_rgba(234,179,8,0.4)]">
                🎛️ Lista Presets M-Vave TANK-G
            </a>
            <a href={`${import.meta.env.BASE_URL}/boss-katana-go-presets`} class="w-full inline-block bg-accentOrange text-bgMain py-3 px-4 rounded text-lg font-bold no-underline transition-transform duration-200 hover:-translate-y-1 hover:bg-[#e68a00] hover:shadow-[0_5px_15px_rgba(234,179,8,0.4)]">
                🎛️ Lista Presets Boss Katana GO
            </a>
            
            <!-- Linha 2 -->
            <a href={`${import.meta.env.BASE_URL}/admin/`} class="w-full inline-block bg-silver text-tolexDark py-3 px-4 rounded text-lg font-bold no-underline transition-transform duration-200 hover:-translate-y-1 hover:bg-white border-2 border-[#111] shadow-[0_4px_10px_rgba(0,0,0,0.5)]">
                ⚙️ Painel de Controle (Admin)
            </a>
            <a href={`${import.meta.env.BASE_URL}/mural`} class="w-full inline-block bg-brushed-metal text-[#111] py-3 px-4 rounded text-lg font-bold no-underline transition-transform duration-200 hover:-translate-y-1 hover:bg-white border-2 border-black shadow-[0_4px_10px_rgba(0,0,0,0.5)]">
                📸 Hall of Fame
            </a>
        </div>
    </div>

    <!-- GLOBAL FILTERS & SEARCH -->
    <div class="bg-black/60 p-6 rounded-xl shadow-[inset_0_2px_10px_rgba(0,0,0,0.8)] border border-black/50 mb-12 max-w-4xl mx-auto flex flex-col gap-6">
        
        <!-- Live Search -->
        <div>
            <h3 class="text-white font-mono text-center font-bold uppercase mb-3 tracking-widest text-lg border-b-2 border-white/10 pb-2">🔍 Buscar Setup</h3>
            <div class="flex justify-center">
                <input 
                    type="text" 
                    id="setupSearchInput"
                    placeholder="Digite a música ou banda..."
                    class="bg-[#111] text-silver font-mono p-3 rounded shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)] border-2 border-black/50 focus:border-mustard focus:outline-none w-full max-w-md text-center"
                />
            </div>
        </div>

        <!-- Fast Setup Katana -->
        <div>
            <h3 class="text-accentOrange font-mono text-center font-bold uppercase mb-3 tracking-widest text-lg border-b-2 border-accentOrange/10 pb-2">⚡ Fast Setup Katana</h3>
            <div class="flex flex-col sm:flex-row justify-center gap-3 w-full max-w-2xl mx-auto">
                <input 
                    type="text" 
                    id="fastKatanaInput"
                    placeholder="Ex: Sweet Child O Mine - Guns N Roses"
                    class="bg-[#111] text-silver font-mono p-3 rounded shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)] border-2 border-accentOrange/30 focus:border-accentOrange focus:outline-none flex-1 text-center sm:text-left min-w-[200px]"
                />
                <button 
                    id="fastKatanaBtn"
                    class="bg-accentOrange text-bgMain font-bold uppercase px-6 py-3 rounded border-2 border-transparent hover:bg-[#e68a00] hover:border-white/20 transition-all flex items-center justify-center min-w-[120px]"
                >
                    <span class="btn-text">Gerar</span>
                </button>
                <a 
                    href={`${import.meta.env.BASE_URL}/boss-katana-go-presets`}
                    class="bg-tolexDark text-accentOrange font-bold uppercase px-4 py-3 rounded border border-accentOrange/30 hover:bg-[#222] hover:border-accentOrange transition-all flex items-center justify-center whitespace-nowrap"
                    title="Ver Collection Katana"
                >
                    📚 Ver Collection
                </a>
            </div>
        </div>

        {allGearTags.length > 0 && (
            <div>
                <h3 class="text-mustard font-mono text-center font-bold uppercase mb-3 tracking-widest text-lg border-b-2 border-mustard/10 pb-2">🏷️ Filtrar por Equipamento</h3>
                <div class="flex justify-center items-center">
                    <select 
                        onchange="if(this.value) window.location.href=this.value"
                        class="bg-[#111] text-silver font-mono p-3 rounded shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)] border-2 border-black/50 focus:border-mustard focus:outline-none w-full max-w-md appearance-none text-center cursor-pointer hover:bg-[#1a1a1a] transition-colors"
                    >
                        <option value="">-- Selecione um Equipamento --</option>
                        {allGearTags.map((tag: string) => {
                            const urlSafeTag = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                            return (
                                <option value={`${import.meta.env.BASE_URL}/gear/${urlSafeTag}`}>
                                    {tag}
                                </option>
                            );
                        })}
                    </select>
                </div>
            </div>
        )}
        
    </div>

    <!-- THUMBS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12" id="setupGrid">
        {setups.map(setup => (
            <div class="thumb-container">
                <SetupThumb 
                    slug={setup.id}
                    title={setup.data.title}
                    artist={setup.data.artist}
                    guitar={setup.data.guitar}
                    pedalsCount={setup.data.pedals ? setup.data.pedals.length : 0}
                />
            </div>
        ))}
    </div>
</Layout>

<script>
    // Live Search Filter
    document.addEventListener('astro:page-load', () => {
        const searchInput = document.getElementById('setupSearchInput');
        const thumbs = document.querySelectorAll('.thumb-container');

        if (searchInput) {
            searchInput.addEventListener('keyup', (e) => {
                const term = e.target.value.toLowerCase();
                
                thumbs.forEach(thumb => {
                    const link = thumb.querySelector('.setup-thumb');
                    if (link) {
                        const title = link.getAttribute('data-title') || '';
                        const artist = link.getAttribute('data-artist') || '';
                        
                        if (title.includes(term) || artist.includes(term)) {
                            thumb.style.display = '';
                        } else {
                            thumb.style.display = 'none';
                        }
                    }
                });
            });
        }

        // Fast Setup Katana Logic
        const katanaInput = document.getElementById('fastKatanaInput') as HTMLInputElement;
        const katanaBtn = document.getElementById('fastKatanaBtn') as HTMLButtonElement;

        if (katanaBtn && katanaInput) {
            katanaBtn.addEventListener('click', async () => {
                const songRequest = katanaInput.value.trim();
                if (!songRequest) {
                    alert('Por favor, digite o nome de uma música ou artista.');
                    return;
                }

                const textSpan = katanaBtn.querySelector('.btn-text');
                const originalText = textSpan ? textSpan.textContent : 'Gerar';
                if (textSpan) textSpan.textContent = 'Gerando... ⏳';
                
                katanaBtn.disabled = true;
                katanaBtn.classList.add('opacity-70', 'cursor-not-allowed');

                try {
                    const response = await fetch(`${import.meta.env.BASE_URL}/api/fast-katana`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ song: songRequest })
                    });

                    if (response.ok) {
                        alert('Katana Setup gerado com sucesso! O arquivo foi salvo na coleção katana.');
                        katanaInput.value = '';
                    } else {
                        const errorData = await response.json();
                        alert(`Erro: ${errorData.error}`);
                    }
                } catch (error) {
                    console.error(error);
                    alert('Erro na comunicação com a API.');
                } finally {
                    if (textSpan) textSpan.textContent = originalText;
                    katanaBtn.disabled = false;
                    katanaBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
            });
        }
    });
</script>
