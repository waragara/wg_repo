---
import Layout from '../../layouts/Layout.astro';
import gearList from '../../data/gear.json';
---

<Layout title="Admin: Gerador de Setup IA">
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <a href={`${import.meta.env.BASE_URL}/`} class="inline-block bg-mustard text-tolexDark py-2 px-6 rounded-md text-sm font-bold no-underline transition-all duration-200 hover:bg-mustardDark hover:shadow-[0_0_15px_rgba(234,179,8,0.5)] border-b-4 border-mustardDark active:translate-y-1 active:border-b-0 uppercase tracking-wide">
                ⬅ Voltar para a Home
            </a>
        </div>

        <div class="bg-brushed-metal p-6 md:p-10 border-4 border-[#111] shadow-[0_10px_30px_rgba(0,0,0,0.9)] rounded-xl relative">
            <!-- Screws -->
            <div class="absolute top-3 left-3 w-3 h-3 rounded-full bg-black/60 shadow-inner border border-black/80"></div>
            <div class="absolute top-3 right-3 w-3 h-3 rounded-full bg-black/60 shadow-inner border border-black/80"></div>
            <div class="absolute bottom-3 left-3 w-3 h-3 rounded-full bg-black/60 shadow-inner border border-black/80"></div>
            <div class="absolute bottom-3 right-3 w-3 h-3 rounded-full bg-black/60 shadow-inner border border-black/80"></div>

            <h1 class="text-3xl md:text-4xl font-black font-slab uppercase tracking-widest text-[#111] drop-shadow-md text-center mb-8 border-b-2 border-[#111]/20 pb-4">
                Gerador de Timbre IA 🤖🎸
            </h1>

            <form id="aiSetupForm" class="flex flex-col gap-8">
                
                <!-- Bloco 1: Prompt de Música/Artista -->
                <div class="bg-black/60 p-6 rounded-xl border border-black/50 shadow-inner">
                    <label for="prompt" class="block font-mono font-bold text-mustard uppercase tracking-wider text-sm mb-3">
                        1. Qual música e artista você quer criar o timbre?
                    </label>
                    <input 
                        type="text" 
                        id="prompt" 
                        name="prompt" 
                        placeholder="ex: Back in Black - AC/DC"
                        required
                        class="w-full bg-black/80 text-silver font-mono p-4 rounded shadow-inner border-2 border-black/50 focus:border-mustard focus:outline-none transition-colors text-lg"
                    />
                </div>

                <!-- Bloco 2: Equipamentos -->
                <div class="bg-black/60 p-6 rounded-xl border border-black/50 shadow-inner">
                    <p class="block font-mono font-bold text-mustard uppercase tracking-wider text-sm mb-4">
                        2. Quais equipamentos você vai usar? (Selecione todos que se aplicam)
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="gearCheckboxes">
                        {gearList.map((gear, index) => (
                            <label class="flex items-start gap-3 cursor-pointer group bg-black/40 p-3 rounded border border-white/5 hover:border-white/20 transition-colors">
                                <div class="relative flex items-center pt-0.5">
                                    <input type="checkbox" name="gear" value={gear} class="peer sr-only" />
                                    <div class="w-5 h-5 bg-black border-2 border-mustard rounded shadow-inner peer-checked:bg-mustard peer-focus:ring-2 peer-focus:ring-mustard/50 transition-all flex items-center justify-center">
                                        <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                        </svg>
                                    </div>
                                </div>
                                <span class="font-mono text-silver text-sm group-hover:text-white transition-colors flex-1 leading-tight">{gear}</span>
                            </label>
                        ))}
                    </div>
                </div>

                <!-- Bloco de Sugestões da IA (Aparece após gerar) -->
                <div id="aiSuggestions" class="hidden bg-black/60 p-6 rounded-xl border border-mustard shadow-inner shadow-mustard/20">
                    <h3 class="text-mustard font-mono font-bold uppercase tracking-wider mb-2 flex items-center gap-2">
                        <span>💡</span>
                        <span>Comentário da IA</span>
                    </h3>
                    <p id="aiSuggestionsText" class="text-silver font-mono text-base leading-relaxed"></p>
                </div>

                <div id="statusMessage" class="hidden p-4 rounded-md font-mono font-bold text-center tracking-wide shadow-inner"></div>

                <button 
                    type="submit" 
                    id="submitBtn"
                    class="mt-2 bg-tolexDark text-mustard py-5 px-6 rounded border-4 border-[#111] shadow-[0_5px_15px_rgba(0,0,0,0.5)] font-slab font-black text-2xl uppercase tracking-widest hover:bg-[#1a1a1a] hover:text-white transition-all active:translate-y-1 flex justify-center items-center gap-3"
                >
                    <span>Gerar Setup com IA</span>
                    <span class="animate-pulse">✨</span>
                </button>
            </form>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('aiSetupForm') as HTMLFormElement;
        const statusMsg = document.getElementById('statusMessage');
        const submitBtn = document.getElementById('submitBtn');

        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const promptInput = document.getElementById('prompt') as HTMLInputElement;
                const prompt = promptInput.value.trim();

                // Get selected gear
                const checkboxes = document.querySelectorAll('input[name="gear"]:checked');
                const selectedGear = Array.from(checkboxes).map((cb: Element) => (cb as HTMLInputElement).value);

                if (!prompt) return;

                // UI Loading state
                if (submitBtn) {
                    submitBtn.innerHTML = '<span class="animate-spin text-2xl">⏳</span> <span>Gerando... Pode levar 1 minuto</span>';
                    submitBtn.setAttribute('disabled', 'true');
                    submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
                }
                
                if (statusMsg) {
                    statusMsg.classList.add('hidden');
                }
                
                const suggestionsBox = document.getElementById('aiSuggestions');
                const suggestionsText = document.getElementById('aiSuggestionsText');
                if (suggestionsBox) suggestionsBox.classList.add('hidden');
                
                try {
                    const response = await fetch(`${import.meta.env.BASE_URL}/api/generate-setup`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ prompt, selectedGear })
                    });

                    const result = await response.json();

                    if (statusMsg) {
                        statusMsg.classList.remove('hidden', 'bg-red-900', 'text-red-300');
                        if (response.ok) {
                            statusMsg.classList.add('bg-green-900', 'text-green-300', 'border', 'border-green-500');
                            statusMsg.textContent = result.message || 'Setup gerado e salvo com sucesso!';
                            
                            // Display suggestions if available
                            if (result.sugestoes && suggestionsBox && suggestionsText) {
                                suggestionsText.textContent = result.sugestoes;
                                suggestionsBox.classList.remove('hidden');
                            }
                            
                        } else {
                            throw new Error(result.error || 'Erro desconhecido');
                        }
                    }
                    
                    // Clear form if success
                    if (response.ok) form.reset();

                } catch (error: any) {
                    console.error('Error generating setup:', error);
                    if (statusMsg) {
                        statusMsg.classList.remove('hidden', 'bg-green-900', 'text-green-300');
                        statusMsg.classList.add('bg-red-900', 'text-red-300', 'border', 'border-red-500');
                        statusMsg.textContent = `Erro: ${error.message}`;
                    }
                } finally {
                    // Restore UI
                    if (submitBtn) {
                        submitBtn.innerHTML = '<span>Gerar Setup com IA</span> <span class="animate-pulse">✨</span>';
                        submitBtn.removeAttribute('disabled');
                        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                    }
                }
            });
        }
    });
</script>
