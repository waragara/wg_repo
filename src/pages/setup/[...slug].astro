---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SetupCard from '../../components/SetupCard.astro';

export async function getStaticPaths() {
  const setups = await getCollection('setups');
  return setups.map(setup => ({
    params: { slug: setup.id },
    props: { setup },
  }));
}

const { setup } = Astro.props;
---

<Layout title={`${setup.data.title} - Tussi RigCraft Labs`}>
    <div class="mb-6">
        <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/`} class="inline-block bg-[#111] text-silver border border-silver/30 py-2 px-6 rounded-md text-sm font-bold no-underline transition-all duration-200 hover:bg-mustard hover:text-black uppercase tracking-wide">
            ⬅ Voltar para o Início
        </a>
    </div>

    <!-- Render the full setup card, passing the slug for view transitions -->
    <SetupCard {...setup.data} slug={setup.id} />
</Layout>
