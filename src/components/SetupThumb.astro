---
export interface Props {
  slug: string;
  title: string;
  artist: string;
  guitar: string;
  pedalsCount: number;
}

const { slug, title, artist, guitar, pedalsCount } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}/setup/${slug}`} class="setup-thumb block relative bg-tolexDark border-4 border-silver rounded-xl shadow-[0_8px_15px_rgba(0,0,0,0.8)] overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_15px_25px_rgba(0,0,0,0.9)] hover:border-mustard group cursor-pointer no-underline text-silver" data-title={title.toLowerCase()} data-artist={artist.toLowerCase()}>
    
    <!-- Screws -->
    <div class="absolute top-1.5 left-1.5 w-2 h-2 rounded-full bg-black/80 shadow-inner"></div>
    <div class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-black/80 shadow-inner"></div>
    <div class="absolute bottom-1.5 left-1.5 w-2 h-2 rounded-full bg-black/80 shadow-inner"></div>
    <div class="absolute bottom-1.5 right-1.5 w-2 h-2 rounded-full bg-black/80 shadow-inner"></div>

    <!-- Cassette Label / Pedal Faceplate -->
    <div class="m-2 mt-4 p-4 bg-tolexLight border border-black/40 rounded shadow-inner flex flex-col h-full justify-between items-center text-center">
        
        <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[#555] block mb-1">Track</span>
            <h3 class="m-0 text-[#111] text-xl font-black font-slab uppercase tracking-wider leading-tight group-hover:text-mustardDark transition-colors" transition:name={`title-${slug}`}>{title}</h3>
            <span class="text-sm font-bold text-[#333] mt-1 block" transition:name={`artist-${slug}`}>{artist}</span>
        </div>

        <div class="mt-4 pt-3 border-t border-black/10 w-full flex justify-between items-center gap-2">
            <!-- Guitar Badge -->
            <div class="bg-black/80 text-silver px-2 py-1 rounded text-[10px] font-mono uppercase tracking-wider truncate flex-1 border border-black/50" title={guitar}>
                🎸 {guitar}
            </div>
            <!-- Pedal Count Badge -->
            <div class="bg-mustard text-tolexDark px-2 py-1 rounded text-[10px] font-bold font-mono uppercase tracking-wider border border-mustardDark whitespace-nowrap shadow-sm">
                🎛️ {pedalsCount} Pedais
            </div>
        </div>

        <!-- Mini footswitch indicator -->
        <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-silver shadow-[inset_0_-1px_2px_rgba(0,0,0,0.5)] flex items-center justify-center">
            <div class="w-1 h-1 rounded-full bg-red-600 shadow-[0_0_5px_red] opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

    </div>
</a>
